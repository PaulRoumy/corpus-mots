# Modèle de deploiement/.env : copier en .env (jamais commité) puis remplir.
# Tout ce qui dépend de la machine est ici ; compose.yaml et Caddyfile restent identiques partout (AD-21).

# Version des images ghcr.io/paulroumy/corpus-mots-{back,front} : tag Git sans le « v » (v1.0.0 → 1.0.0).
VERSION=1.0.0

# Domaine public (enregistrement DNS A vers l'IP du serveur) et e-mail du compte Let's Encrypt.
DOMAINE=corpus-mots.example.fr
ACME_EMAIL=admin@example.fr

# Mots de passe PostgreSQL : superutilisateur postgres, rôle corpusmots (back) et rôle keycloak.
# Lus seulement à la première initialisation du volume postgres-donnees.
POSTGRES_MOT_DE_PASSE=a-remplacer
BD_MOT_DE_PASSE=a-remplacer
KEYCLOAK_BD_MOT_DE_PASSE=a-remplacer

# Compte d'administration de secours de Keycloak (realm master). Sa console n'est pas exposée
# par Caddy : elle ne sert qu'en dépannage, depuis le serveur lui-même.
KEYCLOAK_ADMIN_UTILISATEUR=admin
KEYCLOAK_ADMIN_MOT_DE_PASSE=a-remplacer

# Relais SMTP des e-mails d'invitation et de réinitialisation (Keycloak).
SMTP_HOTE=smtp.example.fr
SMTP_PORT=587
SMTP_EXPEDITEUR=corpus-mots@example.fr
# Passer SMTP_AUTH à true si le relais exige un identifiant et un mot de passe (à renseigner alors).
SMTP_AUTH=false
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
SMTP_STARTTLS=true
SMTP_SSL=false

# Sauvegarde nocturne (sauvegarde.sh, lancé par le timer systemd corpus-mots-sauvegarde.timer).
# Dossier sur le disque externe (obligatoire) ; il doit contenir le fichier repère
# .corpus-mots-sauvegarde, sans quoi le disque est considéré absent (voir README.md).
SAUVEGARDE_DESTINATION=/media/sauvegarde/corpus-mots
# Dossier des fichiers d'état, sur le disque système (défaut : deploiement/etat-sauvegarde/).
SAUVEGARDE_ETAT=
# Nombre de jours de sauvegardes conservés (défaut : 14, de 1 à 9999).
# Ne pas dépasser 14 : la page « Données personnelles » promet 14 jours au plus dans les sauvegardes.
SAUVEGARDE_JOURS=14
